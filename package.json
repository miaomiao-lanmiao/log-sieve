{
  "name": "log-sieve-cli",
  "version": "0.1.0",
  "description": "Offline log triage: group repeated errors, redact common credentials, and export reviewable reports.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "bin": { "logsieve": "dist/cli.js" },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:package": "node tools/package-check.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": { "@types/node": "22.20.5", "typescript": "7.0.2" },
  "keywords": ["logs", "offline", "cli", "triage", "redaction"]
}
